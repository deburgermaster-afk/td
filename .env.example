# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# MetaTrader 5 account credentials
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=your_mt5_server

# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-your-key

# Claude model to use (change to the model you have access to)
AI_MODEL=claude-opus-4-5

# Comma-separated list of symbols to trade
SYMBOLS=BTCUSD,XAUUSD

# Starting capital in account currency (USD)
INITIAL_CAPITAL=50

# Daily profit target (bot logs when reached, but keeps running unless you stop it)
DAILY_TARGET=200

# Risk per trade as a decimal (0.03 = 3%)
RISK_PER_TRADE=0.03

# Daily loss limit as a decimal (0.20 = 20%); bot shuts off for the day if hit
MAX_DAILY_LOSS_PCT=0.20

# Emergency equity floor in account currency; bot halts if equity falls below this
EMERGENCY_EQUITY_FLOOR=25

# Seconds to wait between each trading cycle
TRADE_INTERVAL_SECONDS=300

# Maximum number of trades to place in a single day
MAX_TRADES_PER_DAY=20

# Maximum number of simultaneously open positions
MAX_OPEN_POSITIONS=2

# Risk-to-reward ratio used when calculating take-profit
RR_RATIO=2.0

# Number of consecutive losses before triggering the pause
CONSECUTIVE_LOSS_LIMIT=3

# Duration of the loss-streak pause in seconds (default 1800 = 30 minutes)
LOSS_PAUSE_SECONDS=1800

# ── Risk calculation constants (optional overrides) ───────────────────────────
# ATR multiplier for stop-loss distance (default 1.5 means SL = 1.5 × ATR)
ATR_SL_MULTIPLIER=1.5
# Minimum AI confidence to execute a trade (default 0.65 = 65%)
AI_MIN_CONFIDENCE=0.65

# ── Indicator parameters (optional overrides) ─────────────────────────────────
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
ATR_PERIOD=14
BB_PERIOD=20
BB_STD=2.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=logs
TRADE_LOG_FILE=trade_log.csv
